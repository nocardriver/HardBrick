# ============================================
# HaradBrick (STM32U575xx) - .gitignore
# 工程类型: STM32CubeMX + CMake/Ninja + clang (ATfE) + J-Link
# ============================================

# ---------- 构建产物 (CMake / Ninja) ----------
build/
*/build/
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.elf
*.axf
*.hex
*.bin
*.map
*.lst
*.out
*.d
*.su
*.dep
*.gcda
*.gcno
*.gcov
*.profraw
*.profdata

# CMake 生成文件（若在根目录生成）
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json
CTestTestfile.cmake
Testing/
CMakeUserPresets.json

# ---------- STM32CubeMX ----------
# CubeMX 内部元数据，每次保存自动重写，无需入库
.mxproject
*.ioc.bak
*.ioc.old

# ---------- 调试器 (J-Link / Ozone) ----------
# 本地调试器配置，含个人路径/断点等，不应共享
Debug/
*.jdebug
*.jdebug.user
*.jlink
*.jflash
*.emProject
*.emSession
*.svg

# ---------- IDE / 编辑器 ----------
# .vscode/ 目前只由 STM32Cube for Agentic AI 安装器生成
# （mcp.json / extensions.json），属于本机环境，不入库
.vscode/
.idea/
*.iml
*.swp
*.swo
*~
.*.sw[a-z]
*.code-workspace
*.suo
*.user
*.userosscache
*.sln.docstates
.DS_Store
Thumbs.db
desktop.ini
.clangd/
.cache/
*.orig
*.rej

# ---------- Keil / IAR / Eclipse（备用） ----------
# .settings/ 存放 Cube bundle store/lock（bundles*.store.json）与 Eclipse 配置，均为本机状态
.settings/
*.uvguix.*
*.uvoptx
*.uvproj.bak
*.bak
.project
.cproject
.metadata/
RTE/
DebugConfig/
Listings/
Objects/

# ---------- STM32Cube for Agentic AI（安装器部署） ----------
# cube agentic-ai setup 部署的上下文、指令与部署锁，换机后重新运行 setup 即可重建，
# 不入库以免 600 KB 供应商文本随每次 update 产生冲突。
.cube-ai/
.github/skills/cube-agentic-ai-*/
.github/instructions/cube-agentic-ai-*.instructions.md
# 注意：.github/copilot-instructions.md 是项目级 AI 指令，由人工维护，应正常入库。

# ---------- Python（Agentic AI 上下文的运行时） ----------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/
pip-wheel-metadata/

# ---------- 日志 / 临时文件 ----------
*.log
*.tmp
*.temp
*.cache
